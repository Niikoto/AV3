generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum TipoEventoMovimentacao {
  MOVIMENTACAO
  STATUS
  ESTADO_FISICO
  CANCELAMENTO
  CORRECAO
  ESTORNO
}

enum TipoFalhaEquipamento {
  FUNCIONAL
  ELETRICA
  MECANICA
  DESGASTE
  OUTRA
}

enum TipoRegistroRecuperacao {
  ESTIMADO
  REALIZADO
}

enum CategoriaAnalise {
  EFICIENCIA_OPERACIONAL
  RENTABILIDADE
  VIDA_UTIL_REMANESCENTE
}

enum PermissaoApi {
  RASTREAMENTO_LEITURA
  LOTES_LEITURA
  LOTES_ESCRITA
  ANALISES_LEITURA
}

enum EstadoTarefa {
  AGUARDANDO
  PROCESSANDO
  CONCLUIDA
  FALHOU
  CANCELADA
}

enum TipoRelatorioAsync {
  EFICIENCIA_OPERACIONAL
  RENTABILIDADE
  VIDA_UTIL_REMANESCENTE
  COMPLETO
}

model Organizacao {
  id                String     @id
  razaoSocial       String
  cnpj              String     @unique
  cnpjNormalizado   String     @unique
  inscricaoEstadual String
  enderecoCompleto  String
  telefone          String
  email             String
  dataCadastro      DateTime   @default(now())
  ativo             Boolean    @default(true)
  motivoDesativacao String?
  contratoVigenteId String?
  version           Int        @default(0)
  contratoVigente   Contrato?  @relation("ContratoVigente", fields: [id, contratoVigenteId], references: [organizacaoId, id], onDelete: Restrict)
  contratos         Contrato[] @relation("ContratosOrganizacao")
  lotes             Lote[]
  parceirosApi      ParceiroApi[]

  @@unique([id, contratoVigenteId])
}

model Contrato {
  id                     String       @id
  organizacaoId          String
  dataAssinatura         DateTime
  dataVencimento         DateTime
  clausulas              String[]     @default([])
  valorMensal            Float
  renovacaoAutomatica    Boolean      @default(false)
  encerradoEm            DateTime?
  historicoRenovacoes    Json         @default("[]")
  version                Int          @default(0)
  organizacao            Organizacao  @relation("ContratosOrganizacao", fields: [organizacaoId], references: [id], onDelete: Restrict)
  organizacaoComoVigente Organizacao? @relation("ContratoVigente")

  @@unique([organizacaoId, id])
  @@index([organizacaoId])
}

model Lote {
  id                  String        @id
  dataEntrada         DateTime
  dataConclusaoTriagem DateTime?
  organizacaoId       String
  notaFiscal          String
  transportadora      String
  statusProcessamento StatusLote    @default(RECEBIDO)
  observacoes         String        @default("")
  cancelado           Boolean       @default(false)
  motivoCancelamento  String?
  version             Int           @default(0)
  organizacao         Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  equipamentos        Equipamento[]

  @@index([organizacaoId, dataEntrada])
}

model Equipamento {
  id                  String             @id
  codigoBarrasInterno String             @unique
  tipo                TipoEquipamento
  marca               String
  modelo              String
  anoFabricacao       Int
  estadoFisico        EstadoFisico
  pesoQuilogramas     Float
  loteId              String
  posicaoNoLote       Int
  statusRastreamento  StatusRastreamento @default(AGUARDANDO_TRIAGEM)
  cancelado           Boolean            @default(false)
  motivoCancelamento  String?
  dataCadastro        DateTime?
  version             Int                @default(0)
  lote                Lote               @relation(fields: [loteId], references: [id], onDelete: Restrict)
  movimentacoes       Movimentacao[]
  recuperacoes        RegistroRecuperacao[]
  falhas              FalhaEquipamento[]

  @@unique([loteId, posicaoNoLote])
  @@index([loteId, statusRastreamento])
}

model RegistroRecuperacao {
  id              String      @id
  equipamentoId   String
  tipo            TipoRegistroRecuperacao @default(REALIZADO)
  material        String
  valorRecuperado Decimal     @db.Decimal(12, 2)
  moeda           String      @default("BRL") @db.VarChar(3)
  dataRecuperacao DateTime
  origem          String
  observacao      String      @default("")
  responsavel     String
  criadoEm        DateTime    @default(now())
  equipamento    Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)

  @@index([equipamentoId, dataRecuperacao])
  @@index([dataRecuperacao])
}

model FalhaEquipamento {
  id            String              @id
  equipamentoId String
  tipo          TipoFalhaEquipamento
  dataHora      DateTime
  estadoFisico  EstadoFisico
  descricao     String
  responsavel   String
  criadoEm      DateTime            @default(now())
  equipamento  Equipamento         @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)

  @@index([equipamentoId, dataHora])
  @@index([tipo, dataHora])
}

model Movimentacao {
  id                         String                 @id
  equipamentoId              String
  dataHora                   DateTime               @default(now())
  origem                     String
  destino                    String
  responsavel                String
  observacao                 String
  tipoEvento                 TipoEventoMovimentacao @default(MOVIMENTACAO)
  movimentacaoReferenciadaId String?                @unique
  destinoCorrigido           String?
  equipamento                Equipamento            @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)
  movimentacaoReferenciada   Movimentacao?          @relation("ReferenciasMovimentacao", fields: [movimentacaoReferenciadaId], references: [id], onDelete: Restrict)
  eventosDerivados           Movimentacao[]         @relation("ReferenciasMovimentacao")

  @@index([equipamentoId, dataHora])
}

model Credencial {
  id           String       @id
  usuario      String
  hashSenha    String
  salt         String?
  ultimoAcesso DateTime
  papel        PapelUsuario
  nomeExibicao String
  ativo        Boolean      @default(true)

  @@unique([usuario, ativo])
}

model ParametroGlobal {
  id                    String   @id
  versao                Int      @unique
  aliquotasImpostos     Json
  coeficienteDepreciacao Float
  atualizadoEm          DateTime
  atualizadoPor         String

  @@index([atualizadoEm])
}

model EventoAuditoria {
  id                   String   @id
  timestamp            DateTime @default(now())
  operacao             String
  entidade             String
  dadosAntes           Json?
  dadosDepois          Json?
  usuarioResponsavel   String
  transacaoId          String
  fase                 String
  identificadorAnterior String?

  @@index([timestamp])
  @@index([transacaoId, fase])
}

model TokenRevogado {
  jti       String   @id
  expiraEm  DateTime

  @@index([expiraEm])
}

model ResultadoAnalise {
  id             String           @id
  categoria      CategoriaAnalise
  organizacaoId  String?
  periodoInicio  DateTime?
  periodoFim     DateTime?
  realizadaEm    DateTime         @default(now())
  metodo         String
  resultados     Json
  observacoes    String[]

  @@index([categoria, realizadaEm])
  @@index([realizadaEm])
  @@index([organizacaoId, realizadaEm])
}

model ParceiroApi {
  id             String     @id
  nome           String
  organizacaoId  String
  ativo          Boolean    @default(true)
  criadoEm       DateTime   @default(now())
  desativadoEm   DateTime?
  organizacao    Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  chaves         ChaveApi[]

  @@unique([nome, organizacaoId])
  @@index([organizacaoId, ativo])
}

model ChaveApi {
  id             String       @id
  parceiroId     String
  prefixo        String
  hashSecret     String       @unique
  permissoes     PermissaoApi[]
  ativa          Boolean      @default(true)
  criadaEm       DateTime     @default(now())
  expiraEm       DateTime?
  revogadaEm     DateTime?
  ultimoUsoEm    DateTime?
  parceiro       ParceiroApi  @relation(fields: [parceiroId], references: [id], onDelete: Cascade)

  @@index([parceiroId, ativa])
  @@index([prefixo])
}

model TarefaRelatorio {
  id            String             @id
  parceiroId    String
  chaveId       String
  organizacaoId String
  tipo          TipoRelatorioAsync
  formato       String             @default("json")
  estado        EstadoTarefa       @default(AGUARDANDO)
  tentativas    Int                @default(0)
  erro          String?
  arquivoNome   String?
  criadoEm      DateTime           @default(now())
  iniciadoEm    DateTime?
  concluidoEm   DateTime?

  @@index([parceiroId, criadoEm])
  @@index([organizacaoId, estado])
  @@index([chaveId, criadoEm])
}
